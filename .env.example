# Backend n8n
VITE_N8N_BASE_URL=https://seu-n8n.empresa.com/webhook
# URL completa do webhook do chat. Se `VITE_N8N_BASE_URL` já apontar para
# `/webhook/<path>`, você pode usar apenas essa variável.
VITE_N8N_CHAT_WEBHOOK_URL=https://seu-n8n.empresa.com/webhook/one-drive-tst
# Webhook de upload de arquivo para pasta do OneDrive
VITE_N8N_UPLOAD_WEBHOOK_URL=https://seu-n8n.empresa.com/webhook/upload-onedrive

# API de dados (histórico, dashboard, auditoria, documentos recentes)
# Em desenvolvimento, o Vite faz proxy de /api/data para esta URL.
VITE_DATA_API_URL=/api/data

# API de autenticação LDAP (Active Directory)
# Relativo: o Vite faz proxy de /api/auth para a API Hono (porta 8787).
VITE_AUTH_API_URL=/api/auth

# Configurações opcionais
VITE_SESSION_TIMEOUT_MINUTES=30
VITE_APP_ENV=development
