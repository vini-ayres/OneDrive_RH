# PostgreSQL — usuário dedicado (rode como root: bash scripts/setup-db-user.sh [senha])
DB_USER=onedrive_rh_app
DB_PASSWORD=Z6yHLk0Rf3
DB_HOST=localhost
DB_PORT=5433
DB_NAME=onedrive_rh
DATABASE_URL=postgresql://onedrive_rh_app:Z6yHLk0Rf3@localhost:5433/onedrive_rh

# API
PORT=8787
CORS_ORIGIN=http://localhost:3000

# Autenticação LDAP / Active Directory (BIND da conta de serviço)
LDAP_URL=ldap://10.100.21.3:389
LDAP_BASE_DN=DC=abainfra,DC=local
LDAP_BIND_DN=CN=Service Abapass,OU=Serviços,DC=abainfra,DC=local
LDAP_BIND_PASSWORD=
LDAP_USE_TLS=false
LDAP_GROUP_DN=CN=GRP_docrh_consulta,OU=Azure,OU=Grupos,DC=abainfra,DC=local
LDAP_ADMIN_GROUP_DN=CN=GRP_docrh_admin,OU=Azure,OU=Grupos,DC=abainfra,DC=local

# Assinatura do token de sessão após o login LDAP
AUTH_SESSION_SECRET=change-me-in-production
AUTH_SESSION_MINUTES=30

# MFA (TOTP). Em produção, gere chaves próprias (32 bytes em hex para ENCRYPTION_KEY).
AUTH_MFA_ENCRYPTION_KEY=change-me-mfa-encryption-key-32b
AUTH_MFA_PEPPER=change-me-mfa-pepper
AUTH_MFA_ISSUER=DocRH
AUTH_MFA_PENDING_MINUTES=5

# Chave interna para webhooks n8n
N8N_INTERNAL_API_KEY=8TdxQXtoLiKyaDJTF3TcmYl0E7ERzoAJ

# Retenção LGPD (dias)
AUDIT_RETENTION_DAYS=730
